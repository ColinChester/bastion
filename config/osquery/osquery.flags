--config_path=/var/osquery/osquery.conf
--database_path=/var/osquery/osquery.db
--pidfile=/var/osquery/osqueryd.pidfile
--logger_plugin=filesystem
--logger_path=/var/log/osquery
--host_identifier=hostname
--utc=true
--disable_events=false
--disable_audit=true
--disable_endpointsecurity=false
--disable_endpointsecurity_fim=false
--es_fim_enable_open_events=true
--enable_file_events=true
--events_expiry=3600
--events_max=50000
--schedule_splay_percent=10
--logger_rotate=true
--logger_rotate_size=26214400
--logger_rotate_max_files=5
