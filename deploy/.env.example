# Copy to deploy/.env (scripts/setup-phase2.sh does this and fills it in). Never commit .env.

# Anthropic API key for the agents. Set a $25/month spend limit on this key's workspace
# in the Anthropic Console; Bastion also enforces its own caps below.
ANTHROPIC_API_KEY=

# Token for bastiond's edge API (generated by `sudo bastion enable-edge-api`).
BASTION_EDGE_TOKEN=

# Self-hosted ntfy. The topic acts like a password. NTFY_BASE_URL is the address your
# phone uses (the Tailscale HTTPS name of this Mac, port 8443).
BASTION_NTFY_TOPIC=
NTFY_BASE_URL=
# Address of the incident page, added as the tap target of pushes.
BASTION_CONSOLE_URL=

TZ=America/New_York

# Optional overrides (defaults shown)
# BASTION_AGENT_MODEL=claude-haiku-5-5
# BASTION_WARDEN_MODEL=claude-sonnet-5-5
# BASTION_INCIDENT_CAP_USD=0.15
# BASTION_DAILY_CAP_USD=1.50
# BASTION_MONTHLY_CAP_USD=25
# BASTION_DIGEST_TIME=08:30
# BASTION_BACKLOG_HOURS=0

# Phase 3 (filled in by scripts/setup-phase3.sh). The signing key itself is NOT here: it
# lives in deploy/.env.gateway, which only the gateway container reads.
# BASTION_GATEWAY_TOKEN=
# COMPOSE_PROFILES=actions
